# Copy to benchmarks/common/config/.env.local and edit per machine/user.
#
# Example:
# cp benchmarks/common/config/.env.example benchmarks/common/config/.env.local

# Path to db_bench binary.
DB_BENCH=/absolute/path/to/rocksdb/db_bench

# Base directories for benchmark data. Use fast local SSD/NVMe on each machine.
DB_BASE_DIR=/tmp/rocksdb_data
WAL_BASE_DIR=/tmp/rocksdb_wal
OUTPUT_DIR=/tmp/bench_results/cpu

# GPU compaction local artifact roots (datasets + sweep outputs).
# Keep these outside tracked source trees or under a gitignored local-artifacts folder.
CPU_COMPACTION_OUT_ROOT=/tmp/bench_results/cpu_compaction/sweep_results
CPU_COMPACTION_PRELOAD_ROOT=/tmp/bench_results/cpu_compaction/preload
GPU_COMPACTION_OUT_ROOT=/tmp/bench_results/gpu_compaction/sweep_results
GPU_COMPACTION_DATASET_ROOT=/tmp/bench_results/gpu_compaction/datasets

# Common defaults (optional and can be overwritten by inline args)
# THREADS=1
# KEY_SIZE=16
# COMPRESSION_TYPE=none
# VALUE_SIZES="32 64 128 256"
# SUBCOMP_THREADS_LIST="1 2 4 8"
# BG_COMP_THREADS_LIST="1"
# MAX_BACKGROUND_FLUSHES=2
# DIRECT_IO=true  # true|false
# OPEN_FILES=-1
# METRICS_INTERVAL_MS=1000
# HOST_METRICS_INTERVAL_SEC=1
# HOST_METRICS_DEVICE=nvme0n1  # optional; auto-detected from DB_BASE_DIR if unset
# THREAD_STATUS_PER_INTERVAL=5
# REPORT_BG_IO_STATS=1
# RUN_PAUSE_SECONDS=60

# GP-Comp paper-specific defaults (optional overrides)
# WRITE_BUFFER_SIZE=8388608
# TARGET_FILE_SIZE_BASE=8388608
# MAX_BYTES_FOR_LEVEL_BASE=67108864
# BLOCK_RESTART_INTERVAL=4
# BLOCK_SIZE=32768
# BLOOM_BITS=10
# LEVEL0_FILE_NUM_COMPACTION_TRIGGER=4
# LEVEL0_SLOWDOWN_WRITES_TRIGGER=8
# LEVEL0_STOP_WRITES_TRIGGER=12
