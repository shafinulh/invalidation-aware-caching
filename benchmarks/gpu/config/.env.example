# Copy to benchmarks/gpu/config/.env.local and edit per machine/user.
#
# Example:
# cp benchmarks/gpu/config/.env.example benchmarks/gpu/config/.env.local

# Base directory for temporary benchmark data files (use fast NVMe/SSD).
# The benchmark creates and removes temp files under this path.
DATA_DIR=/tmp/gpu_io_bench_data

# Root output directory for results (CSV, logs, plots).
OUTPUT_DIR=/tmp/bench_results/gpu

# GPU device ordinal (default 0).
GPU_DEVICE=0

# cuFile compatibility mode.
# On GPUs without GDS support (e.g. GeForce), cuFile automatically falls back
# to a bounce-buffer path through CPU/RAM.  Set to true to acknowledge this.
COMPAT_MODE=true

# Workload parameters (L0_SIZES, NUM_L0_READ, NUM_L1_WRITE, ALIGNMENT,
# NUM_REPS, DIRECT_IO) are set by the experiment scripts under
# benchmarks/gpu/experiments/io_bench/.
